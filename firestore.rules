rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserId() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsLegacyOwnerUid() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function createsForCurrentUser() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Contas vinculadas ao usuário autenticado.
    match /contas/{docId} {
      allow get: if signedIn()
        && (docId == request.auth.uid
          || resource.data.ownerUid == request.auth.uid);
      allow list: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && (docId == request.auth.uid
          || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
        && docId != request.auth.uid
        && resource.data.ownerUid == request.auth.uid;
    }

    // Tarefas: novos registros usam userId. ownerUid é aceito somente
    // para permitir localizar e migrar registros antigos do mesmo usuário.
    match /tarefas/{taskId} {
      allow get: if ownsUserId() || ownsLegacyOwnerUid();
      allow list: if ownsUserId() || ownsLegacyOwnerUid();
      allow create: if createsForCurrentUser();
      allow update: if (ownsUserId() || ownsLegacyOwnerUid())
        && request.resource.data.userId == request.auth.uid;
      allow delete: if ownsUserId() || ownsLegacyOwnerUid();
    }

    // Datas importantes seguem a mesma regra de propriedade.
    match /datas_importantes/{dateId} {
      allow get: if ownsUserId() || ownsLegacyOwnerUid();
      allow list: if ownsUserId() || ownsLegacyOwnerUid();
      allow create: if createsForCurrentUser();
      allow update: if (ownsUserId() || ownsLegacyOwnerUid())
        && request.resource.data.userId == request.auth.uid;
      allow delete: if ownsUserId() || ownsLegacyOwnerUid();
    }

    // Anotações, se armazenadas nesta coleção, também ficam privadas.
    match /anotacoes/{noteId} {
      allow get: if ownsUserId() || ownsLegacyOwnerUid();
      allow list: if ownsUserId() || ownsLegacyOwnerUid();
      allow create: if createsForCurrentUser();
      allow update: if (ownsUserId() || ownsLegacyOwnerUid())
        && request.resource.data.userId == request.auth.uid;
      allow delete: if ownsUserId() || ownsLegacyOwnerUid();
    }
  }
}
